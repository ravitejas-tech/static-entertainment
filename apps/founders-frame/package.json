{
    "name": "founders-frame",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "yarn ts:check && react-router build",
        "dev": "react-router dev",
        "preview": "vite preview --outDir build/client --port 7302 --strictPort",
        "ts:check": "react-router typegen && tsc",
        "lint": "eslint app/",
        "lint:fix": "eslint app/ --fix",
        "format": "prettier --write \"app/**/*.{ts,tsx,css}\""
    },
    "dependencies": {
        "@react-router/node": "^8.5.1",
        "isbot": "^5.1.36",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.5.1"
    },
    "devDependencies": {
        "@eslint/js": "^9",
        "@react-router/dev": "^8.5.1",
        "@tailwindcss/vite": "^4.2.2",
        "@types/node": "^22",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "eslint": "^9",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.2.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.0.3"
    },
    "version": "0.1.0",
    "engines": {
        "node": ">=22.22.0"
    }
}
